# InsurAI Environment Configuration Example

# Backend Settings (SpringBoot)
SERVER_PORT=8081

# MySQL Configuration
# If connecting to your local MySQL 8.0 server:
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/insurai_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password
SPRING_DATASOURCE_DRIVER=com.mysql.cj.jdbc.Driver

# Fallback Configuration (In-memory H2 if MySQL is unavailable)
# SPRING_DATASOURCE_URL=jdbc:h2:mem:insuraidb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
# SPRING_DATASOURCE_USERNAME=sa
# SPRING_DATASOURCE_PASSWORD=
# SPRING_DATASOURCE_DRIVER=org.h2.Driver

# JWT Secret
JWT_SECRET=InsurAIEnterpriseSecureJwtSecretKeyMustBe32BytesOrLonger
JWT_EXPIRATION=86400000

# Frontend Settings (Vite React)
VITE_API_BASE_URL=http://localhost:8081/api
